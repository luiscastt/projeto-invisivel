# Modo local: nenhuma chave externa necessária. Não exponha este modo na internet.
APP_ENV=development
AUTH_PROVIDER=local
SEED_DEMO=true
PUBLIC_ORIGIN=http://127.0.0.1:5173
# DATABASE_URL=sqlite:///data/invisivel.db
# DATA_DIR=data
# OFFICIAL_DIR=data/official
# Produção: defina domínio real e Supabase Auth com confirmação de e-mail obrigatória.
# APP_ENV=production
# AUTH_PROVIDER=supabase
# DATABASE_URL=postgresql+psycopg://invisivel:senha@db:5432/invisivel
# PUBLIC_ORIGIN=https://invisivel.seudominio.gov.br
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=chave-publica-publishable-ou-anon
# ADMIN_EMAILS=moderacao@seudominio.org
# SEED_DEMO=false
# DOMAIN=invisivel.seudominio.org
# POSTGRES_PASSWORD=senha_forte_sem_caracteres_reservados_de_URL
# API privada no backend; nunca use prefixo VITE_ nem versione o valor real.
PORTAL_TRANSPARENCIA_API_KEY=

# Supabase / Vercel: backend only. Never use VITE_ for secrets.
# DATABASE_SCHEMA=invisivel
# STORAGE_PROVIDER=supabase
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=invisivel-evidence
# SUPABASE_ANON_KEY accepts the public sb_publishable_ key.
# When PUBLIC_ORIGIN is omitted on Vercel, the environment domain is used.
